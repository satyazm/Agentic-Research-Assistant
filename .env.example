# ── Copy this file to `.env` and fill in your own keys ───────────────────────
#     cp .env.example .env
#
# NEVER commit the real `.env` — it is git-ignored on purpose.

# Google Gemini — used by the planner and every research agent.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY3=your_gemini_api_key_here

# Semantic Scholar (optional) — raises rate limits for citation / reference
# lookups. Without it the app still works but may hit 429s on heavy use.
# Request one at https://www.semanticscholar.org/product/api
S2_API_KEY=
